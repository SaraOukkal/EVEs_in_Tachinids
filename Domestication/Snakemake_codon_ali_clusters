# Importation des packages nécessaires
import re
from Bio import SeqIO
import os
import pandas as pd

#Software :
Mafft="/beegfs/project/horizon/bin/miniconda3/bin/mafft"
Trimal="/beegfs/project/horizon/bin/miniconda3/bin/trimal"

# Définition des chemins
Cluster_seqs_path = "/beegfs/data/soukkal/Thesis/Tachinid_Project/Results/Clustering/Filtered_Clusters/Clusters_fasta/"
Cluster_alignment_path = "/beegfs/data/soukkal/Thesis/Tachinid_Project/Results/Domestication/Codon_ali/"

# Liste des clusters à aligner
Clusters_to_align = pd.read_csv("/beegfs/data/soukkal/Thesis/Tachinid_Project/Results/Clustering/Filtered_Clusters/Clusters_less90per_schizophora.txt", header=None)
list_Clusters_to_align = list(Clusters_to_align[0])

# Règle pour aligner les clusters
rule all:
    input:
        expand(Cluster_alignment_path+"{cluster_ali}.fna.aln", cluster_ali=list_Clusters_to_align),
        expand(Cluster_alignment_path+"{cluster_ali}.fna.aln.trimmed", cluster_ali=list_Clusters_to_align)


# Règle pour aligner les clusters
rule codon_alignment : 
	params:
		threads="1",
		time="10:00:00",
		mem="5G",
		name="Cluster_alignment_{cluster_ali}",
		out=Cluster_alignment_path+"Logs/Mafft_{cluster_ali}.out",
		err=Cluster_alignment_path+"Logs/Mafft_{cluster_ali}.err"
	input:
		Cluster_file=Cluster_seqs_path+"{cluster_ali}.fna"
	output:
		alignment_file=Cluster_alignment_path+"{cluster_ali}.fna.aln"
	shell:
		"""
		{Mafft} {input.Cluster_file} > {output.alignment_file}
		"""


rule trim_alignement : 
    params:
        threads="1",
        time="10:00:00",
        mem="5G",
        name="Ali_trimming_{cluster_ali}",
        out=Cluster_alignment_path+"Logs/Trimal_{cluster_ali}.out",
        err=Cluster_alignment_path+"Logs/Trimal_{cluster_ali}.err"
    input:
        alignment_file=Cluster_alignment_path+"{cluster_ali}.fna.aln"
    output:
        alignment_file_trimmed=Cluster_alignment_path+"{cluster_ali}.fna.aln.trimmed"
    shell:
        """
        {Trimal} -in {input.alignment_file} -out {output.alignment_file_trimmed} -automated1
        """
