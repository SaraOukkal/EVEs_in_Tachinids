#Data pathways :
Reads_dir="/beegfs/data/soukkal/Thesis/Tachinid_Project/Assembly/Reads/"
Output_dir="/beegfs/data/soukkal/Thesis/Tachinid_Project/Assembly/"
Logs_dir="/beegfs/data/soukkal/Thesis/Tachinid_Project/Assembly/logs/"
Soft_dir="/beegfs/home/soukkal/miniconda3/bin/"

#Species list :
Genome_IDS_table=pd.read_csv("/beegfs/data/soukkal/Thesis/Tachinid_Project/Assembly/Species_list_diptera_20G.txt",header=None)
list_Genome_IDs=list(Genome_IDS_table[0])

rule all:
        input:
                expand(Output_dir+"Trimmed_Reads/{Genome_ID}_1.trimmed.fastq", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"Trimmed_Reads/{Genome_ID}_2.trimmed.fastq", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"Genomes/{Genome_ID}.contigs.fa", Genome_ID = list_Genome_IDs)

rule Trimming:
        params:
                threads="3",
                time="10:00:00",
                name="Trim_{Genome_ID}",
                mem="1G",
                out=Logs_dir+"Trim_{Genome_ID}.out",
                err=Logs_dir+"Trim_{Genome_ID}.error"
        input:
                R1=Reads_dir+"{Genome_ID}_1.fastq",
                R2=Reads_dir+"{Genome_ID}_2.fastq"
        output:
                R1=Output_dir+"Trimmed_Reads/{Genome_ID}_1.trimmed.fastq",
                R2=Output_dir+"Trimmed_Reads/{Genome_ID}_2.trimmed.fastq"
        shell:
                """
                fastp --in1 {input.R1} --in2 {input.R2} --out1 {output.R1} --out2 {output.R2}
                """

rule Assembly :
        params:
                threads="12",
                time="12:00:00",
                mem="60G",
                name="Assembly_{Genome_ID}",
                out=Logs_dir+"Assembly_{Genome_ID}.out",
                err=Logs_dir+"Assembly_{Genome_ID}.error"
        input:
                R1=Output_dir+"Trimmed_Reads/{Genome_ID}_1.trimmed.fastq",
                R2=Output_dir+"Trimmed_Reads/{Genome_ID}_2.trimmed.fastq"
        output:
                Genome=Output_dir+"Genomes/{Genome_ID}.contigs.fa"
        shell:
                """
                hostname
                {Soft_dir}megahit -1 {input.R1} -2 {input.R2} -f -t {params.threads} -o {Output_dir}Genomes --out-prefix {wildcards.Genome_ID}
                """
