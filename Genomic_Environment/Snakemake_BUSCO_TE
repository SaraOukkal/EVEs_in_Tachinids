        """
        # Lire le contenu du fichier full_table.tsv en ignorant les lignes commençant par '#', récup la colonne scaffolds, trier, compter le nombre d'occurences uniques, retirer les espaces de début de ligne, et inverser les deux colonnes 
        grep -v '^#' {input.BUSCO_file} | cut -f3 | sort | uniq -c | sed 's/^[ \t]*//' | awk '{{print $2"\t"$1}}' > {output.BUSCO_count}
